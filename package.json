{
  "name": "reading-clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:mcp": "wrangler deploy -c wrangler.mcp.jsonc",
    "deploy:web": "wrangler deploy -c wrangler.web.jsonc",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p src/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "dry-run": "wrangler deploy --dry-run && wrangler deploy --dry-run -c wrangler.mcp.jsonc && wrangler deploy --dry-run -c wrangler.web.jsonc",
    "test": "vitest run",
    "setup:aigw": "node --experimental-strip-types scripts/setup-ai-gateway.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.80",
    "@ai-sdk/provider": "^4.0.18",
    "@modelcontextprotocol/server": "2.1.0",
    "ai": "^7.0.114",
    "marked": "18.0.14",
    "slack-edge": "^1.3.17",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.6",
    "@types/node": "^26",
    "typescript": "^7",
    "vitest": "5.0.1",
    "wrangler": "^4.139.0"
  }
}
